# ============================================================
# TIIX SQL Studio - environment template
# ============================================================
# Copy this file to `.env` and replace every placeholder with your
# own value.
#
#   Copy-Item .env.example .env
#
# RULES
#   * `.env` is ignored by Git and excluded from the deployment
#     upload. This template is NOT: it is tracked on purpose, so it
#     must contain placeholders only. Never put a real credential,
#     a real access code or a private key in this file.
#   * Every value below is optional to copy literally, but the
#     application FAILS CLOSED (HTTP 503) until APP_API_KEY is set,
#     and /api/ask needs a provider key to answer.
#   * Nothing here is logged or returned by the application.
# ============================================================

# ------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------

# Shared secret guarding the /api surface (sessions, uploads,
# approvals, reports, /api/version). It is also the signing key
# derived for visitor cookies. Long and random; never committed.
APP_API_KEY=

# ------------------------------------------------------------
# LLM PROVIDER (at least one required for /api/ask)
# ------------------------------------------------------------

# "nvidia" (default) or "gemini"
LLM_PROVIDER=nvidia

# NVIDIA provider (LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_MODEL=

# NVIDIA endpoint override; leave unset for the official default.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Gemini provider (LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# ------------------------------------------------------------
# VISITOR ACCESS (FREE TRIAL + APP ACCESS CODE)
# ------------------------------------------------------------

# The code a visitor exchanges for a session once the six free
# attempts are used. LEFT EMPTY ON PURPOSE: this file is tracked, so
# it must never carry a usable code, and the application itself ships
# no default either - with an empty value the unlock endpoint refuses
# every code (401) until the deployment configures one. Set a long,
# unguessable value in your own .env and in the deployment
# environment variables. Never commit it.
APP_ACCESS_CODE=

# Optional dedicated signing secret for visitor cookies. Derived from
# APP_API_KEY when left empty.
ACCESS_SIGNING_SECRET=

# Free questions per browser before the unlock dialog appears.
# Attempts 1-6 are answered; the 7th returns FREE_TRIAL_EXHAUSTED and
# the dialog explains how to get a code.
TRIAL_MAX_ATTEMPTS=6

# Lifetimes, in seconds.
TRIAL_SESSION_TTL_SECONDS=2592000
ACCESS_SESSION_TTL_SECONDS=43200

# Anonymous upload identity. An upload needs no sign-in and no code: the
# first /api/visitor/* request mints a signed HttpOnly cookie and every
# visitor route resolves only inside that visitor's own namespace.
# VISITOR_COOKIE_NAME=tiix_visitor
# VISITOR_SESSION_TTL_SECONDS=2592000

# Contact address shown in the unlock dialog as a mailto: link, so a
# visitor whose trial has ended can ask the owner for a code. The
# application never sends mail itself: nothing is delivered
# automatically, and /api/access/request stores nothing.
OWNER_CONTACT_EMAIL=zerroukiabdellah5@gmail.com

# ------------------------------------------------------------
# AUTHENTICATION (safe defaults)
# ------------------------------------------------------------
# AUTH_COOKIE_NAME=tiix_session
# AUTH_SESSION_TTL_SECONDS=43200
# Secure cookies are on automatically on Vercel, off on localhost.
# AUTH_COOKIE_SECURE=0

# ------------------------------------------------------------
# RATE LIMITING (safe defaults)
# ------------------------------------------------------------
# APP_RATE_LIMIT_ENABLED=1
# ASK_RATE_LIMIT_REQUESTS=20
# ASK_RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_RATE_LIMIT_REQUESTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# UPLOAD_RATE_LIMIT_REQUESTS=10
# UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
# ACCESS_UNLOCK_RATE_LIMIT_REQUESTS=10
# ACCESS_UNLOCK_RATE_LIMIT_WINDOW_SECONDS=300
# ACCESS_REQUEST_RATE_LIMIT_REQUESTS=10
# ACCESS_REQUEST_RATE_LIMIT_WINDOW_SECONDS=300

# ------------------------------------------------------------
# LLM TIMEOUT AND CONCURRENCY (safe defaults)
# ------------------------------------------------------------
# LLM_TIMEOUT_SECONDS=60
# LLM_RETRIES is fixed in source; the backoff cap is configurable.
# LLM_RETRY_BACKOFF_CAP_SECONDS=5
# LLM_MAX_CONCURRENCY=4
# LLM_CONCURRENCY_RETRY_AFTER_SECONDS=1

# ------------------------------------------------------------
# UPLOAD STORAGE
# ------------------------------------------------------------
# Where imported uploads live between the request that stores them
# and the request that queries them. See app/storage.py.
#
# STORAGE_BACKEND selects the backend:
#
#   local (default) - a filesystem store. On Vercel the writable
#                     filesystem is a per-instance /tmp that does not
#                     survive a recycle and is not shared between
#                     instances, so "local" is NOT durable there. It is
#                     what development and the test suite use.
#
#   r2              - Cloudflare R2 over its S3-compatible API, durable
#                     and shared. Requires R2_ACCOUNT_ID,
#                     R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY and
#                     R2_BUCKET. Incomplete credentials are treated as
#                     "not configured".
#
# Any other value, "r2" without credentials, or "local" while
# STORAGE_REQUIRE_PERSISTENT is set, FAILS CLOSED with HTTP 503 - the
# application never silently falls back to ephemeral storage.
STORAGE_BACKEND=local

# Set to 1 in production to refuse uploads entirely while only
# non-durable storage is configured, turning silent data loss into a
# clear 503.
STORAGE_REQUIRE_PERSISTENT=0

# How long an import is kept, in seconds, before the next import in
# its namespace sweeps it away. 0 disables expiry. Defaults to 30
# days, matching the visitor cookie lifetime.
UPLOAD_TTL_SECONDS=2592000

# ------------------------------------------------------------
# UPLOAD STORAGE: CLOUDFLARE R2 (used only when STORAGE_BACKEND=r2)
# ------------------------------------------------------------
# Never commit real values. These are read-only to the application's
# responses: they are never logged and never returned, only used to
# build the S3 client.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. The endpoint defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com and the region to
# "auto" (correct for R2). R2_PREFIX parks every object under a key
# prefix, so one bucket can be shared with another application.
# R2_ENDPOINT=
# R2_REGION=auto
# R2_PREFIX=

# ------------------------------------------------------------
# RUNTIME PATHS (safe defaults; /tmp is used automatically on Vercel)
# ------------------------------------------------------------
# META_DB_PATH=
# UPLOAD_DIR=
